{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_display_name}",
  "description": "${mod_description}",
  "authors": [
    "${mod_authors}"
  ],
  "contact": {
    "homepage": "${mod_homepage}",
    "issues": "${mod_issues}",
    "sources": "${mod_source}"
  },
  "license": "${mod_license}",
  "icon": "assets/${mod_id}/${mod_logo}",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.${mod_id}.Initializer",
      "io.github.flemmli97.improvedmobs.fabric.ImprovedMobsFabric"
    ],
    "client": [
      "io.github.flemmli97.improvedmobs.fabric.client.ImprovedMobsFabricClient"
    ]
  },
  "provides": [
    "improvedmobs"
  ],
  "accessWidener": "improvedmobs.accesswidener",
  "mixins": [
    "${mod_id}-common.mixins.json",
    "improvedmobs.mixins.json",
    "improvedmobs.fabric.mixins.json"
  ],
  "depends": {
    "fabric-api": "*",
    "minecraft": "${fabric_minecraft_version_range}",
    "majruszlibrary": "${fabric_majruszlibrary_version_range}",
    "tenshilib": "*",
    "forgeconfigapiport": "*"
  },

  "contributors": [
    "Flemmli97 (Improved Mobs, merged in)",
    "DereckAn (unofficial 26.3 port)"
  ]
}
